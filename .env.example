# Copy this file to .env and paste in YOUR OWN keys:
#
#   cp .env.example .env            # macOS / Linux
#   Copy-Item .env.example .env     # Windows
#
# .env is gitignored and must stay that way. A key in a commit is a key on the
# internet — treat one that leaks as already spent, and revoke it at the source.
#
# Only the first key is needed to start. The rest arrive with session 4, where
# the assistant learns to talk to any provider through one interface.


# --- Gemini — the only key you need for sessions 1-3 --------------------------
# Free, no card: https://aistudio.google.com/apikey
# The SDK reads GEMINI_API_KEY itself; you never pass it in code.
GEMINI_API_KEY= 

# ⚠️ FREE-TIER PROMPTS ARE USED TO TRAIN GOOGLE'S MODELS. Google lists "content
# used to improve our products" as Yes for the free tier, No for paid. Never
# paste real customer data, real names or anything from an employer into a
# free-tier notebook. Every ticket in data/tickets.yml is invented for this reason.


# --- Groq — free, and the fast one -------------------------------------------
# Free, no card: https://console.groq.com/keys
# Serves OPEN-WEIGHTS models (Llama, Qwen, OpenAI's gpt-oss) on custom hardware.
# Worth having: it makes "the provider is one line of configuration" something
# you can feel rather than read. Same free-tier caution as above.
GROQ_API_KEY=

# --- OpenAI and Anthropic — optional, and billed from the first token ---------
# https://platform.openai.com/api-keys  ·  https://console.anthropic.com/settings/keys
# Session 4 demonstrates five providers behind one interface. These two are
# demonstrated from committed output, so you are never asked to enable billing
# to finish a session. Fill them in only if you already have a paid account.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Ollama — models on your own laptop, no key at all ------------------------
# Nothing to paste. Ollama runs open-weights models on your machine: no account,
# no bill, and no request ever leaves the laptop — which is the honest answer to
# "we cannot send customer data to a third party".
#   1. install      https://ollama.com/download
#   2. pull a model  ollama pull llama3.2:3b     (~2 GB, once)
#   3. serve         ollama serve                (leave it running)


# --- LangSmith — from session 4 ----------------------------------------------
# Your own free account: https://smith.langchain.com — your traces stay in your
# workspace. Once tracing is on, every call the assistant makes is recorded with
# its inputs, outputs, latency and tokens, and you wrote no code to get it.
#
# These keep their plain names (no SHOPWISE_ prefix) because the LangSmith SDK
# reads them from the environment itself. Leave TRACING false until the key is
# filled in — on without a key it warns, then posts traces nobody receives.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=shopwise


# --- Settings — all optional --------------------------------------------------
# From session 3 the configuration is a typed Pydantic model: open the newest
# session-NN/project/config.py and the field list IS the documentation. Every
# field has a working default, so this whole block can stay commented out.
# Every field is read as SHOPWISE_<FIELD>.
#
#   SHOPWISE_PROVIDER=google_genai          # who serves the model (session 4 on)
#   SHOPWISE_MODEL=gemini-3.1-flash-lite    # course default: cheapest, fast
#   SHOPWISE_MODEL_STRONG=gemini-3.6-flash  # when quality matters more
#   SHOPWISE_MAX_OUTPUT_TOKENS=1024         # ceiling on one reply
#   SHOPWISE_REQUEST_TIMEOUT_S=60           # give up on one call
#
# Note the UNDERSCORE in google_genai. The pip package is hyphenated
# (langchain-google-genai) and the provider id is not; the hyphenated form
# raises "Unable to infer model provider", which reads like a complaint about
# your model id and is not.
