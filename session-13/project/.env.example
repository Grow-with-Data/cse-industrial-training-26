# ShopWise v10 — every setting, in the same order as src/shopwise/core/config.py.
# House rule from v10: a variable is in BOTH files, or in neither.
#
# Copy to project/.env (or keep using labs/.env; project/.env wins when both exist).
# Every line below is commented out and shows its default: uncomment to change it.

# ── keys (unprefixed: the SDKs read these names themselves) ─────────────────
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# GROQ_API_KEY=                       # the FALLBACK provider
# TAVILY_API_KEY=                     # [ADV] market analyst only
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=false
# LANGSMITH_PROJECT=default

# ── the app ─────────────────────────────────────────────────────────────────
# SHOPWISE_APP_NAME=ShopWise Support Assistant
# SHOPWISE_VERSION=10.0.0
# SHOPWISE_ENVIRONMENT=development    # development | staging | production

# ── models ──────────────────────────────────────────────────────────────────
# SHOPWISE_PROVIDER=openrouter
# SHOPWISE_MODEL=openai/gpt-oss-20b
# SHOPWISE_MODEL_STRONG=gemini-3.8-flash
# SHOPWISE_MODEL_SEARCH=gemini-3.5-flash-lite
# SHOPWISE_MODEL_PRO=gemini-3.1-pro-preview
# SHOPWISE_EMBED_MODEL=gemini-embedding-2
# SHOPWISE_EMBED_DIM=768
# SHOPWISE_MAX_OUTPUT_TOKENS=4096
# SHOPWISE_REQUEST_TIMEOUT_S=60
# SHOPWISE_MAX_RETRIES=4
# SHOPWISE_FALLBACK=groq:openai/gpt-oss-20b
# SHOPWISE_MAX_CONCURRENCY=4
# SHOPWISE_REQUESTS_PER_SECOND=0.25
# SHOPWISE_USE_FEW_SHOT=false
# SHOPWISE_PROMPT_VERSION=

# ── data and the knowledge base ─────────────────────────────────────────────
# Paths default to labs/data and labs/.state; set an ABSOLUTE path to move one
# (a relative path would be read from wherever the server was started).
# SHOPWISE_DATA_DIR=/absolute/path/to/labs/data
# SHOPWISE_QDRANT_PATH=/absolute/path/to/labs/.state/qdrant
# SHOPWISE_CHUNK_SIZE=800
# SHOPWISE_CHUNK_OVERLAP=160
# SHOPWISE_RAG_K=4
# SHOPWISE_RETRIEVAL_MODE=dense       # dense | keyword | hybrid
# SHOPWISE_RERANK=false
# SHOPWISE_RERANK_FETCH=20
# SHOPWISE_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# SHOPWISE_RAG_FUSION=false
# SHOPWISE_FUSION_QUERIES=3
# SHOPWISE_RRF_K=60
# SHOPWISE_RAG_HYDE=false
# SHOPWISE_RAG_GRADE=false
# SHOPWISE_RAG_MAX_ATTEMPTS=2
# SHOPWISE_JUDGE=
# SHOPWISE_EVAL_DATASET=shopwise-kb-questions

# ── conversation, memory, checkpoints ───────────────────────────────────────
# SHOPWISE_SUMMARY_TRIGGER_TOKENS=4000
# SHOPWISE_SUMMARY_KEEP_MESSAGES=20
# SHOPWISE_CHECKPOINT_DB=/absolute/path/to/labs/.state/checkpoints.sqlite
# SHOPWISE_MEMORY_DB=/absolute/path/to/labs/.state/memory.sqlite
# SHOPWISE_REFUND_LEDGER=/absolute/path/to/labs/.state/refunds_issued.jsonl
# SHOPWISE_SUMMARIZE_AFTER=12
# SHOPWISE_SUMMARY_KEEP=4
# SHOPWISE_REWRITE_FOLLOWUPS=true
# SHOPWISE_AS_OF=2026-08-09

# ── the team ────────────────────────────────────────────────────────────────
# SHOPWISE_ROUTING=hybrid             # hybrid | supervisor | code
# SHOPWISE_MAX_HOPS=4
# SHOPWISE_MARKET_ANALYST=false
# SHOPWISE_KB_SCHEME=plain            # plain | contextual | parent
# SHOPWISE_SELF_QUERY=true
# SHOPWISE_KB_CACHE_TTL=0
# SHOPWISE_PARENT_CHILD_SIZE=250
# SHOPWISE_MCP_TRANSPORT=stdio        # stdio | streamable_http | off
# SHOPWISE_MCP_URL=http://127.0.0.1:8001/mcp

# ── v10: the HTTP API ───────────────────────────────────────────────────────
# SHOPWISE_API_PREFIX=/v1
# SHOPWISE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# SHOPWISE_APP_DB=/absolute/path/to/labs/.state/api.sqlite
# SHOPWISE_IDEMPOTENCY_TTL_S=86400
# SHOPWISE_PAGE_SIZE_MAX=50
# SHOPWISE_LOG_LEVEL=INFO
